[sub_resource type="Shader" id="Shader_environment_blend"]
code = "shader_type canvas_item;

uniform vec4 shadow_tint : source_color = vec4(0.10, 0.08, 0.20, 1.0);
uniform vec4 highlight_tint : source_color = vec4(0.38, 0.31, 0.62, 1.0);
uniform float opacity : hint_range(0.0, 1.0) = 0.78;

void fragment() {
	vec4 tex = texture(TEXTURE, UV);
	float value = dot(tex.rgb, vec3(0.299, 0.587, 0.114));
	float shaped_value = smoothstep(0.04, 0.9, value);
	vec3 graded = mix(shadow_tint.rgb, highlight_tint.rgb, shaped_value);
	COLOR = vec4(graded, tex.a * opacity);
}
"

